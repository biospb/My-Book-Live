From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MBL build <mbl@localhost>
Date: Mon, 2 Nov 2026 20:44:57 +0300
Subject: [PATCH 8/8] dma-direct: zero remapped coherent buffers through the
 cached alias

dma_direct_alloc() cleared remapped (uncached) buffers with memset() on
the uncached mapping. On 44x memset() uses dcbz, which takes an alignment
exception on uncached memory; 6.1 emulates it and warns once per boot
(WARN_ON_ONCE in fix_alignment). Zero the lowmem kernel alias before
arch_dma_prep_coherent(), which writes the lines back to RAM, and skip the
memset() on the remap.
---
 kernel/dma/direct.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/kernel/dma/direct.c b/kernel/dma/direct.c
index d4215739efc7..1463a549fd90 100644
--- a/kernel/dma/direct.c
+++ b/kernel/dma/direct.c
@@ -208,6 +208,7 @@ static void *dma_direct_alloc_no_mapping(struct device *dev, size_t size,
 void *dma_direct_alloc(struct device *dev, size_t size,
 		dma_addr_t *dma_handle, gfp_t gfp, unsigned long attrs)
 {
+	bool zeroed = false;
 	bool remap = false, set_uncached = false;
 	struct page *page;
 	void *ret;
@@ -285,6 +286,16 @@ void *dma_direct_alloc(struct device *dev, size_t size,
 		if (force_dma_unencrypted(dev))
 			prot = pgprot_decrypted(prot);
 
+		/*
+		 * Zero through the cached kernel alias: memset() on the uncached
+		 * remap uses dcbz, which traps (alignment exception) on 44x.
+		 * arch_dma_prep_coherent() then writes the zeroes back to RAM.
+		 */
+		if (!PageHighMem(page)) {
+			memset(page_address(page), 0, size);
+			zeroed = true;
+		}
+
 		/* remove any dirty cache lines on the kernel alias */
 		arch_dma_prep_coherent(page, size);
 
@@ -299,7 +310,8 @@ void *dma_direct_alloc(struct device *dev, size_t size,
 			goto out_leak_pages;
 	}
 
-	memset(ret, 0, size);
+	if (!zeroed)
+		memset(ret, 0, size);
 
 	if (set_uncached) {
 		arch_dma_prep_coherent(page, size);
-- 
