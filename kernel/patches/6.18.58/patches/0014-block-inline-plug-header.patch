+/* APM821xx: inline the plug entry for the ext4 writeback hot path
+ * (single-CPU NAS; the out-of-line copy stays in blk-core.c for modules). */
+void __blk_plug_init(struct blk_plug *plug, unsigned short nr_ios);
+static inline void blk_start_plug(struct blk_plug *plug)
+{
+	struct task_struct *tsk = current;
+
+	if (unlikely(tsk->plug))
+		return;
+	__blk_plug_init(plug, 1);
+	tsk->plug = plug;
+}
