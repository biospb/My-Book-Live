+/* SSR0 produces 1500-byte IP packets, not an arbitrary TCP MSS. */
+static netdev_features_t emac_features_check(struct sk_buff *skb,
+		struct net_device *ndev, netdev_features_t features)
+{
+	if (skb_is_gso(skb)) {
+		unsigned int ip_len = skb_transport_offset(skb) -
+			skb_network_offset(skb) + tcp_hdrlen(skb) +
+			skb_shinfo(skb)->gso_size;
+
+		if (ip_len != 1500 || ip_len > ndev->mtu)
+			features &= ~NETIF_F_GSO_MASK;
+	}
+	return features;
+}
