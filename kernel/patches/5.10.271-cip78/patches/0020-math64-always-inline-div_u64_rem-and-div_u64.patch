From 1d2bc9c9efc13e8b8d1e00061a5a6d677324e792 Mon Sep 17 00:00:00 2001
From: MBL-build <mbl@localhost>
Date: Mon, 2 Nov 2026 06:30:53 +0300
Subject: [PATCH 20/20] math64: always inline div_u64_rem() and div_u64()

On 32-bit, do_div() turns a constant divisor into a multiply
(__div64_const32), but only if the compiler inlines the helper. When
div_u64_rem() is emitted out of line, every constant divisor
(NSEC_PER_USEC in tcp_clock_us() and friends) goes through the
__div64_32() shift-subtract loop instead.
---
 include/linux/math64.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/linux/math64.h b/include/linux/math64.h
index 1cc61d748e1f..d49b167b4596 100644
--- a/include/linux/math64.h
+++ b/include/linux/math64.h
@@ -22,7 +22,7 @@
  * This is commonly provided by 32bit archs to provide an optimized 64bit
  * divide.
  */
-static inline u64 div_u64_rem(u64 dividend, u32 divisor, u32 *remainder)
+static __always_inline u64 div_u64_rem(u64 dividend, u32 divisor, u32 *remainder)
 {
 	*remainder = dividend % divisor;
 	return dividend / divisor;
@@ -86,7 +86,7 @@ static inline s64 div64_s64(s64 dividend, s64 divisor)
 #define div64_ul(x, y)   div_u64((x), (y))
 
 #ifndef div_u64_rem
-static inline u64 div_u64_rem(u64 dividend, u32 divisor, u32 *remainder)
+static __always_inline u64 div_u64_rem(u64 dividend, u32 divisor, u32 *remainder)
 {
 	*remainder = do_div(dividend, divisor);
 	return dividend;
@@ -121,7 +121,7 @@ extern s64 div64_s64(s64 dividend, s64 divisor);
  * divide.
  */
 #ifndef div_u64
-static inline u64 div_u64(u64 dividend, u32 divisor)
+static __always_inline u64 div_u64(u64 dividend, u32 divisor)
 {
 	u32 remainder;
 	return div_u64_rem(dividend, divisor, &remainder);
