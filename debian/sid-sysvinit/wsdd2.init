#!/bin/sh
### BEGIN INIT INFO
# Provides:          wsdd2
# Required-Start:    $network $remote_fs smbd
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: WS-Discovery/LLMNR responder, makes the Samba shares visible in the Windows network
### END INIT INFO

# Debian only ships a systemd unit for wsdd2. IPv4 only: IPv6 is disabled in the MBL 4.19 kernel.

DAEMON=/usr/sbin/wsdd2
PIDFILE=/run/wsdd2.pid
WSDD2_OPTS="-4 -i eth0"

[ -x "$DAEMON" ] || exit 0
. /lib/lsb/init-functions

case "$1" in
	start)
		log_daemon_msg "Starting WS-Discovery responder" "wsdd2"
		start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$PIDFILE" \
			--exec "$DAEMON" -- $WSDD2_OPTS
		log_end_msg $?
		;;
	stop)
		log_daemon_msg "Stopping WS-Discovery responder" "wsdd2"
		start-stop-daemon --stop --quiet --retry 5 --pidfile "$PIDFILE" --exec "$DAEMON"
		log_end_msg $?
		rm -f "$PIDFILE"
		;;
	restart|force-reload)
		$0 stop
		$0 start
		;;
	status)
		status_of_proc -p "$PIDFILE" "$DAEMON" wsdd2
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
		exit 1
		;;
esac
